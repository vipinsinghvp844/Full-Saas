APP_NAME="Fitnexa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated frontend URLs allowed for CORS
# Local development: keep localhost
# Production (Render): replace with your Vercel URL
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────
# LOCAL (MySQL): comment out the pgsql block below
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fullsaas
DB_USERNAME=root
DB_PASSWORD=

# PRODUCTION (PostgreSQL on Render): uncomment and fill below
# DB_CONNECTION=pgsql
# DB_URL=postgresql://fitnexa_user:PASSWORD@dpg-xxx.ohio-postgres.render.com/fitnexa
# DB_HOST=dpg-xxx.ohio-postgres.render.com
# DB_PORT=5432
# DB_DATABASE=fitnexa
# DB_USERNAME=fitnexa_user
# DB_PASSWORD=your_password
# DB_SSLMODE=require

# ── Session / Cache / Queue ───────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=604800

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@fitnexa.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Payment Gateways (set in Super Admin dashboard) ──────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
