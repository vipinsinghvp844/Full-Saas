APP_NAME="Gym SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated frontend URLs for CORS (add your Render/Vercel URL in production)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local Docker MySQL (your machine)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fullsaas
DB_USERNAME=root
DB_PASSWORD=

# Render / production: set these in Render Dashboard → Environment (never commit real values)
# DB_HOST=your-render-db-host.onrender.com
# DB_PORT=5432
# DB_DATABASE=your_db_name
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password
# If Render gives PostgreSQL, use: DB_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

JWT_SECRET=
JWT_TTL=3600
JWT_REFRESH_TTL=604800

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
